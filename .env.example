# --- CockroachDB Cloud (required) ---
# Console -> your cluster -> Connect -> copy the connection string
DATABASE_URL=postgresql://user:password@host:26257/defaultdb?sslmode=verify-full

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
# AWS credentials come from the standard AWS chain (aws configure / env vars)
# Claude model on Bedrock (needs model access enabled in the Bedrock console)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6
# Titan Embeddings v2 -> 1024 dimensions (matches VECTOR(1024) in the schema)
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# "bedrock" for real embeddings, "fake" for deterministic offline embeddings
EMBEDDINGS_PROVIDER=bedrock

# --- S3 (optional: invoice PDF storage) ---
S3_BUCKET=

# --- PSP simulator (fake payment provider) ---
PSP_LATENCY_MS=300
# set to 1 to make the NEXT psp call fail once (chaos testing)
PSP_FAIL_NEXT=0

# --- Crash injection (used by the crash tests / demos) ---
# one of: AFTER_INTENT, AFTER_VALIDATED, AFTER_EXECUTING_WRITE, AFTER_PSP_CALL, AFTER_EXECUTED
CRASH_AT=
